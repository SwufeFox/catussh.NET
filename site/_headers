/*
  Cloudflare Pages headers for the product page.

  The design system is copied from the app by tools/sync-site.mjs; the copies are
  content-stable across deploys, so they can be cached hard. The HTML must not be,
  or a new deploy would keep serving the previous page.
*/

/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/*.css
  Cache-Control: public, max-age=3600, must-revalidate

/*.js
  Cache-Control: public, max-age=3600, must-revalidate

/monitor-fixture.json
  Cache-Control: public, max-age=3600, must-revalidate
